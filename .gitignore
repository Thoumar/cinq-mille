# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev toolchain (Flutter SDK, Android SDK, JDK) — user-space installs, not vendored
/.toolchain

# safety net: this sandbox's uid has no passwd entry, so a misbehaving JVM
# call can fall back to a literal "?" for user.home and write junk there
/mobile/android/?/
/mobile/android/app/?/

# Flutter/Dart
/mobile/.dart_tool/
/mobile/.flutter-plugin-dependencies
/mobile/build/
/mobile/android/.gradle/
/mobile/android/local.properties
/mobile/android/app/debug.keystore
/mobile/android/**/gradle-wrapper.jar
/mobile/ios/Flutter/Flutter.podspec
/mobile/ios/Pods/
/mobile/ios/.symlinks/
/mobile/**/*.g.dart
/mobile/**/*.freezed.dart

# typescript
*.tsbuildinfo
next-env.d.ts
